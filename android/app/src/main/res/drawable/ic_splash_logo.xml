<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">

    <!-- Deep Space Safe Canvas (288x288, Safe Circle Radius 80dp at 144,144) -->
    <group
        android:pivotX="0"
        android:pivotY="0"
        android:scaleX="0.62"
        android:scaleY="0.62"
        android:translateX="144"
        android:translateY="144">
        
        <group
            android:translateX="-255"
            android:translateY="-272.5">

            <!-- Glowing Outer Note Layer -->
            <path
                android:pathData="M 262,326 L 262,178 L 330,216"
                android:strokeWidth="24"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:strokeColor="#50FF3157" />

            <path
                android:pathData="M 220,326 m -42,0 a 42,42 0 1,0 84,0 a 42,42 0 1,0 -84,0"
                android:strokeWidth="24"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:strokeColor="#50FF3157" />

            <!-- Pristine 4K Master Note Layer -->
            <path
                android:pathData="M 262,326 L 262,178 L 330,216"
                android:strokeWidth="18"
                android:strokeLineCap="round"
                android:strokeLineJoin="round">
                <aapt:attr name="android:strokeColor">
                    <gradient
                        android:startX="178"
                        android:startY="178"
                        android:endX="330"
                        android:endY="326"
                        android:type="linear">
                        <item android:offset="0.0" android:color="#FFFF3157" />
                        <item android:offset="0.5" android:color="#FFFF174F" />
                        <item android:offset="1.0" android:color="#FFFF3157" />
                    </gradient>
                </aapt:attr>
            </path>

            <path
                android:pathData="M 220,326 m -42,0 a 42,42 0 1,0 84,0 a 42,42 0 1,0 -84,0"
                android:strokeWidth="18"
                android:strokeLineCap="round"
                android:strokeLineJoin="round">
                <aapt:attr name="android:strokeColor">
                    <gradient
                        android:startX="178"
                        android:startY="178"
                        android:endX="330"
                        android:endY="326"
                        android:type="linear">
                        <item android:offset="0.0" android:color="#FFFF3157" />
                        <item android:offset="0.5" android:color="#FFFF174F" />
                        <item android:offset="1.0" android:color="#FFFF3157" />
                    </gradient>
                </aapt:attr>
            </path>

        </group>
    </group>
</vector>
