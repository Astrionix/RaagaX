<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Main Active Theme (No raw black window, matches RaagaX dark theme) -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>
        <item name="android:statusBarColor">@color/colorBackground</item>
    </style>

    <!-- Instant RaagaX Branded Launch Surface -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/bg_splash_brand</item>
        <item name="android:windowBackground">@drawable/bg_splash_brand</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>
        <item name="android:statusBarColor">@color/colorBackground</item>
    </style>
</resources>