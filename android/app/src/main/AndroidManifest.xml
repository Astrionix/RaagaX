<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
    ╔══════════════════════════════════════════════════════════════════╗
    ║  RaagaX — Permission Declaration                                ║
    ║                                                                  ║
    ║  Philosophy: Only what is needed. No runtime prompts at launch.  ║
    ║  See PermissionManager.java for the contextual runtime flow.     ║
    ╚══════════════════════════════════════════════════════════════════╝
    -->

    <!-- ── NETWORK ─────────────────────────────────────────────────── -->
    <!-- Required for streaming audio and API calls. No user prompt.   -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ── BACKGROUND MEDIA PLAYBACK ──────────────────────────────── -->
    <!-- Required for Media3 ExoPlayer foreground service.             -->
    <!-- No runtime user prompt — manifest-only declarations.          -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- ── WAKE LOCK ────────────────────────────────────────────────── -->
    <!-- Prevents CPU sleep during network streaming. No user prompt.   -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ── NOTIFICATIONS (Android 13+) ────────────────────────────── -->
    <!-- Runtime prompt requested ONLY when user first plays a song.   -->
    <!-- Not at launch. See NotificationPermission.java                -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ── BLUETOOTH (Optional — requested only in Connect flow) ───── -->
    <!-- Runtime prompt requested ONLY when user opens Connect Device.  -->
    <!-- Never at first launch. See BluetoothPermission.java           -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- ── EXPLICITLY NOT DECLARED ────────────────────────────────── -->
    <!--  ✗ ACCESS_FINE_LOCATION   — not needed for music playback     -->
    <!--  ✗ RECORD_AUDIO           — no voice features yet             -->
    <!--  ✗ READ_CONTACTS          — not needed                        -->
    <!--  ✗ READ_PHONE_STATE       — audio focus handles call pausing  -->
    <!--  ✗ CAMERA                 — not needed                        -->
    <!--  ✗ READ_EXTERNAL_STORAGE  — use app-specific storage APIs     -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            RaagaX Native Media3 Foreground Playback Service
            Plain Service (not MediaSessionService) — calls startForeground()
            immediately in onStartCommand() — no 5-second timeout issue.
        -->
        <service
            android:name=".RaagaXPlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- RaagaX Home Screen Liquid Lens Widget Provider -->
        <receiver
            android:name=".RaagaXWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_raaga_player_info" />
        </receiver>
    </application>

</manifest>
