{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raagax",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_SYNC_WS_URL": "wss://raaga-sync-server.onrender.com",
    "NEXT_PUBLIC_CONNECT_SERVER_URL": "https://raaga-sync-server.onrender.com"
  },
  "build": {
    "command": "npx @opennextjs/cloudflare build --dangerouslyUseUnsupportedNextVersion"
  },
  "minify": true,
  "observability": {
    "enabled": true
  }
}
