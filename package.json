{
  "name": "raagax",
  "version": "1.0.0",
  "private": true,
  "description": "RaagaX - Futuristic Music Streaming Platform & High Performance Music API Engine",
  "main": "electron/main.js",
  "scripts": {
    "predev": "node scripts/clean-dev.js",
    "dev": "next dev",
    "clean": "cmd /c \"if exist .next rmdir /s /q .next\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "electron:dev": "concurrently \"next dev\" \"wait-on tcp:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder --win",
    "doctor": "node scripts/doctor.js",
    "export:app": "node scripts/export-app.js",
    "apk:sync": "npx cap copy android && npx cap sync android",
    "apk:build": "node scripts/clean-apks.js && npm run export:app && npm run apk:sync && cd android && build-apk.bat",
    "apk:open": "npx cap open android"
  },
  "build": {
    "appId": "com.raagax.music",
    "productName": "RaagaX Lossless Pro",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/app-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@hono/node-server": "^1.14.0",
    "@hono/zod-openapi": "^0.19.2",
    "@hono/zod-validator": "^0.9.0",
    "@react-three/drei": "^9.108.4",
    "@react-three/fiber": "^8.16.8",
    "@scalar/hono-api-reference": "^0.7.4",
    "@supabase/supabase-js": "^2.112.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.7.5",
    "idb": "^8.0.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.462.0",
    "next": "^14.2.15",
    "node-forge": "^1.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swr": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.166.1",
    "zod": "^3.24.2",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/deep-eql": "^4.0.2",
    "@types/estree": "^1.0.9",
    "@types/node": "^22.13.14",
    "@types/node-forge": "^1.3.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.166.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.47",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9",
    "wait-on": "^9.1.0"
  }
}
