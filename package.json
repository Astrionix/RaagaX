{
  "name": "raagax",
  "version": "1.0.0",
  "private": true,
  "description": "RaagaX - Futuristic Music Streaming Platform & High Performance Music API Engine",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "electron/main.js",
  "scripts": {
    "predev": "node scripts/clean-dev.js",
    "dev": "next dev -H 0.0.0.0",
    "clean": "cmd /c \"if exist .next rmdir /s /q .next\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "electron:dev": "concurrently \"next dev\" \"wait-on tcp:3000 && electron .\"",
    "electron:build": "npm run desktop:build:win",
    "desktop:icons": "node scripts/generate-desktop-icons.js",
    "desktop:build:mac": "npm run desktop:icons && npm run export:app && electron-builder --mac",
    "desktop:build:mac:arm64": "npm run desktop:icons && npm run export:app && electron-builder --mac dmg --arm64",
    "desktop:build:mac:universal": "npm run desktop:icons && npm run export:app && electron-builder --mac dmg --universal",
    "desktop:build:win": "npm run desktop:icons && npm run export:app && electron-builder --win",
    "desktop:build:win:x64": "npm run desktop:icons && npm run export:app && electron-builder --win nsis portable --x64",
    "desktop:build:all": "npm run desktop:icons && npm run export:app && electron-builder -mw",
    "doctor": "node scripts/doctor.js",
    "export:app": "node scripts/export-app.js",
    "apk:sync": "npx cap copy android && npx cap sync android",
    "apk:build": "node scripts/build-apk.js",
    "apk:open": "npx cap open android",
    "build:cf": "node scripts/clean-build.js && node scripts/patch-next-standalone.js && npx @opennextjs/cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "deploy": "npx wrangler deploy",
    "deploy:cf": "npm run build:cf && npx wrangler deploy",
    "postinstall": "node scripts/patch-next-standalone.js"
  },
  "build": {
    "appId": "com.raagax.music",
    "productName": "RaagaX Lossless Pro",
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "files": [
      "out/**/*",
      "!out/releases/**",
      "electron/**/*",
      "package.json",
      "!**/node_modules/**"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/brand/icon.ico"
    },
    "nsis": {
      "artifactName": "RaagaX-Windows-Universal.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RaagaX Lossless Pro",
      "uninstallDisplayName": "RaagaX Lossless Pro",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.music",
      "icon": "public/brand/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@hono/node-server": "^1.14.0",
    "@hono/zod-openapi": "^0.19.2",
    "@hono/zod-validator": "^0.9.0",
    "@react-three/drei": "^9.108.4",
    "@react-three/fiber": "^8.16.8",
    "@scalar/hono-api-reference": "^0.7.4",
    "@supabase/supabase-js": "^2.112.2",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.7.5",
    "idb": "^8.0.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.462.0",
    "next": "^14.2.15",
    "node-forge": "^1.3.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swr": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.166.1",
    "zod": "^3.24.2",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/deep-eql": "^4.0.2",
    "@types/estree": "^1.0.9",
    "@types/node": "^22.13.14",
    "@types/node-forge": "^1.3.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.166.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.47",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9",
    "wait-on": "^9.1.0",
    "wrangler": "^4.128.0"
  }
}
