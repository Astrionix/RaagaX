<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12 and newer; see
   backup_rules.xml for why these files are excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="raaga_auth.xml" />
        <exclude domain="sharedpref" path="raaga_auth_plain.xml" />
        <exclude domain="sharedpref" path="raaga_sources.xml" />
        <exclude domain="sharedpref" path="raaga_sources_plain.xml" />
        <!-- Drive backup: the account grant belongs to this phone (see DriveBackup). -->
        <exclude domain="sharedpref" path="raaga_drive_backup.xml" />
        <!-- Other devices' listening and what this one last uploaded: Drive sync's, and re-fetched from Drive. -->
        <exclude domain="file" path="listening-peers/" />
        <exclude domain="file" path="listening-synced/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="raaga_auth.xml" />
        <exclude domain="sharedpref" path="raaga_auth_plain.xml" />
        <exclude domain="sharedpref" path="raaga_sources.xml" />
        <exclude domain="sharedpref" path="raaga_sources_plain.xml" />
        <!-- Drive backup: the account grant belongs to this phone (see DriveBackup). -->
        <exclude domain="sharedpref" path="raaga_drive_backup.xml" />
        <!-- Other devices' listening and what this one last uploaded: Drive sync's, and re-fetched from Drive. -->
        <exclude domain="file" path="listening-peers/" />
        <exclude domain="file" path="listening-synced/" />
    </device-transfer>
</data-extraction-rules>
