<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all theming; this just gives an edge-to-edge, action-bar-free window. -->
    <style name="Theme.Raaga" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.Raaga.LockScreen" parent="Theme.Raaga">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
</resources>
